{
  "name": "demokrat-parti-ankara",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "cross-env DATABASE_URL=file:./dev.db prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "cross-env DATABASE_URL=file:./dev.db prisma generate",
    "prisma:db:push": "cross-env DATABASE_URL=file:./dev.db prisma db push",
    "prisma:seed": "cross-env DATABASE_URL=file:./dev.db ts-node --transpile-only prisma/seed.ts",
    "postinstall": "cross-env DATABASE_URL=file:./dev.db prisma generate"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "lucide-react": "^0.460.0",
    "next": "14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
